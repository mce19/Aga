---
import NavLink from './NavLink.astro';
import ThemeToggle from './ThemeToggle.astro';
import siteConfig from '../data/site-config';

const navLinks = siteConfig.headerNavLinks || [];
---

<header id="site-nav" class="fixed top-4 left-0 right-0 z-50 px-4 md:px-8">
    <div class="w-full max-w-3xl mx-auto">
        <div class="nav-pill flex items-center justify-between gap-4 px-4 py-2.5 rounded-2xl border border-main/15 bg-main/40 backdrop-blur-xl shadow-lg transition-all duration-300">

            <!-- Logo / Brand -->
            <a href="/Aga" class="flex items-center gap-2 shrink-0 font-serif font-semibold text-main text-lg leading-none hover:opacity-80 transition-opacity">
                <span class="flex items-center justify-center w-7 h-7 rounded-lg bg-main text-bg-main border border-main/30 text-sm font-bold">W</span>
                <span class="hidden sm:block">{siteConfig.title}</span>
            </a>

            <!-- Nav links (desktop) -->
            {
                navLinks.length > 0 && (
                    <>
                        <button
                            class="menu-toggle w-8 h-8 flex items-center justify-center relative z-30 md:hidden"
                            aria-label="Open Menu"
                            aria-expanded="false"
                            aria-controls="menu-items"
                        >
                            <span class="menu-toggle-icon w-5 h-px relative bg-current" />
                        </button>

                        <ul id="menu-items" class="menu flex items-center gap-1">
                            {navLinks.map((link) => (
                                <li>
                                    <NavLink
                                        class="text-sm font-medium px-3 py-1.5 rounded-lg text-main hover:bg-muted transition-colors duration-150 md:text-sm"
                                        href={link.href}
                                    >
                                        {link.text}
                                    </NavLink>
                                </li>
                            ))}
                        </ul>
                    </>
                )
            }

            <!-- Theme toggle -->
            <div class="shrink-0">
                <ThemeToggle />
            </div>
        </div>
    </div>
</header>

<!-- Spacer so content doesn't hide under the fixed nav -->
<div class="h-28"></div>

<style>
    /* Mobile menu dropdown */
    @media (max-width: 767px) {
        .menu {
            @apply flex-col items-start gap-1 absolute top-full left-0 right-0 mt-2 px-3 py-3 rounded-2xl bg-main border border-main/20 shadow-xl invisible opacity-0;
            backdrop-filter: blur(12px);
        }
        .menu.is-visible {
            @apply visible opacity-100;
            transition: opacity 0.2s ease 0.05s;
        }
        .menu li {
            @apply w-full;
        }
        .menu a {
            @apply block w-full text-base px-3 py-2;
        }

        /* Hamburger icon */
        .menu-toggle-icon {
            transition: width 0.1s cubic-bezier(0.4, 0, 0.2, 1) 0.2s;
        }
        .menu-toggle.is-active .menu-toggle-icon {
            @apply w-0;
            transition: width 0.1s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .menu-toggle-icon:before,
        .menu-toggle-icon:after {
            @apply w-5 h-px absolute left-1/2 top-0 origin-center -translate-x-1/2 bg-current;
            content: '';
            transition:
                transform 0.2s cubic-bezier(0.4, 0, 0.2, 1),
                margin 0.2s cubic-bezier(0.4, 0, 0.2, 1) 0.2s;
        }
        .menu-toggle-icon:before { @apply -mt-1.5; }
        .menu-toggle-icon:after  { @apply mt-1.5; }
        .menu-toggle.is-active .menu-toggle-icon:before,
        .menu-toggle.is-active .menu-toggle-icon:after {
            @apply mt-0;
            transition: margin 0.2s cubic-bezier(0.4, 0, 0.2, 1), transform 0.2s cubic-bezier(0.4, 0, 0.2, 1) 0.2s;
        }
        .menu-toggle.is-active .menu-toggle-icon:before { @apply rotate-45; }
        .menu-toggle.is-active .menu-toggle-icon:after  { @apply -rotate-45; }
    }

    /* Scrolled state — makes the nav slightly more opaque */
    #site-nav.scrolled .nav-pill {
        @apply shadow-xl;
        background-color: rgb(var(--color-bg-main) / 0.65);
    }
</style>

<script>
    // Menu toggle
    function menuToggle() {
        const menu = document.querySelector('.menu');
        const menuToggleBtn = document.querySelector('.menu-toggle');
        menuToggleBtn?.addEventListener('click', () => {
            const isExpanded = menuToggleBtn.getAttribute('aria-expanded') === 'true';
            menuToggleBtn.classList.toggle('is-active');
            menuToggleBtn.setAttribute('aria-expanded', isExpanded ? 'false' : 'true');
            menuToggleBtn.setAttribute('aria-label', isExpanded ? 'Open Menu' : 'Close Menu');
            menu?.classList.toggle('is-visible');
        });
    }
    menuToggle();
    document.addEventListener('astro:after-swap', menuToggle);

    // Scroll class for styling
    function handleScroll() {
        const nav = document.getElementById('site-nav');
        if (!nav) return;
        nav.classList.toggle('scrolled', window.scrollY > 20);
    }
    window.addEventListener('scroll', handleScroll, { passive: true });
    document.addEventListener('astro:after-swap', () => {
        window.addEventListener('scroll', handleScroll, { passive: true });
        handleScroll();
    });
    handleScroll();
</script>
